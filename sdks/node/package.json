{
	"name": "@brotu/ai",
	"version": "0.5.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"import": "./dist/catalog.js",
			"require": "./dist/catalog.cjs"
		}
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"lint": "bunx --bun biome lint src",
		"format": "bunx --bun biome format --write src",
		"docs:catalog": "bun run scripts/generate-catalog-doc.ts",
		"build": "tsup && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"gate": "bun run scripts/gate.ts",
		"prepublishOnly": "bun run gate && bun run build",
		"docs:json": "bun run scripts/generate-catalog-json.ts",
		"docs": "bun run docs:catalog && bun run docs:json"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3",
		"@aws-sdk/s3-request-presigner": "^3"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1111.0",
		"@aws-sdk/s3-request-presigner": "^3.1111.0",
		"@biomejs/biome": "2.3.11",
		"@types/bun": "^1.3.9",
		"@types/node": "^26.2.0",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	},
	"description": "One TypeScript client for generative video, image, speech and text across native provider APIs.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist",
		"CATALOG.md",
		"README.md",
		"LICENSE"
	],
	"module": "./dist/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Zorbi-Tech/brotu.git",
		"directory": "sdks/node"
	},
	"homepage": "https://github.com/Zorbi-Tech/brotu",
	"bugs": {
		"url": "https://github.com/Zorbi-Tech/brotu/issues"
	}
}
