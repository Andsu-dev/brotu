{
	"name": "@brotu/social",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./meta": {
			"types": "./dist/providers/meta.d.ts",
			"import": "./dist/providers/meta.js",
			"require": "./dist/providers/meta.cjs"
		},
		"./youtube": {
			"types": "./dist/providers/youtube.d.ts",
			"import": "./dist/providers/youtube.js",
			"require": "./dist/providers/youtube.cjs"
		}
	},
	"scripts": {
		"lint": "bunx --bun biome lint src",
		"format": "bunx --bun biome format --write src",
		"build": "tsup && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/bun": "^1.3.9",
		"@types/node": "^26.2.0",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	},
	"description": "One TypeScript client for publishing to social platforms, with the OAuth and webhooks that come with them.",
	"license": "MIT",
	"publishConfig": { "access": "public" },
	"engines": { "node": ">=18" },
	"files": ["dist", "README.md", "LICENSE"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Zorbi-Tech/brotu.git",
		"directory": "sdks/social"
	},
	"homepage": "https://github.com/Zorbi-Tech/brotu",
	"bugs": { "url": "https://github.com/Zorbi-Tech/brotu/issues" }
}
